.DS_Store

# Local Netlify folder
.netlify

# Deno lockfile — a local byproduct of `netlify dev`, never a build input.
# Netlify's edge bundler runs Deno with `--no-config` (or from a temp dir with
# its own generated deno.json), so a repo-root deno.lock is never read. Ours
# was committed once and then rotted for months against package.json, since no
# Dependabot ecosystem covers it. Don't commit it back.
deno.lock

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Git worktrees
.worktrees/
.claude/worktrees/

# Local Codex and Playwright MCP state
.codex/environments/
.playwright-mcp/

# Generated icons (produced by scripts/generate-icons.ts at build time)
public/apple-touch-icon.png
public/apple-touch-icon-precomposed.png

# Generated script outputs (contain guest PII — never commit)
scripts/output/
# Hand-written script inputs (offline RSVPs, keyed by real guest names — never commit)
scripts/input/
docs/IV_MTR_UserGuide_v2.19.8.pdf
# France website source material (draft copy + private venue photos — never commit)
docs/france-website-copy-edits/
docs/france-website-photo-replacements/
