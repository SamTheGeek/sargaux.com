---
import WireframeLayout from '../../layouts/WireframeLayout.astro';
import { generateTokenIfPossible } from '../../lib/calendar';
import { getGuestParty, getLatestRSVPForParty } from '../../lib/notion';
import { strings } from '../../content/strings';
import type { LocalizedString } from '../../content/strings';
import { createTranslator } from '../../lib/i18n';
import SiteFooter from '../../components/SiteFooter.astro';
import CalendarCta from '../../components/CalendarCta.astro';
import { features } from '../../config/features';
import '../../styles/france-details.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const guestId = Astro.locals.guestId;
const guest = Astro.locals.guest;
const t = createTranslator(Astro.locals.lang ?? 'en');
const calendarToken = generateTokenIfPossible(guestId);
const sch = strings.france.schedule;
const dc = strings.france.dressCode;

/* The calendar button depends on where the party is with their France RSVP:
 *   - attending (incl. partial) → subscribe link, no note
 *   - declined                  → greyed-out button + short note
 *   - not yet (or unknown)      → button and note both lead to the RSVP form
 * The page is `no-store`, so this is read live on every request. A Notion
 * failure falls back to "not yet": sending someone to their RSVP (which
 * pre-fills whatever they already submitted) is harmless. */
type RsvpState = 'attending' | 'declined' | 'none';
let rsvpState: RsvpState = 'none';
if (guestId) {
  try {
    const party = await getGuestParty(guestId);
    const latest = await getLatestRSVPForParty(
      party.length > 0 ? party.map((member) => member.id) : [guestId],
      'france',
    );
    if (latest) rsvpState = latest.status === 'Declined' ? 'declined' : 'attending';
  } catch (error) {
    console.error('Failed to load France RSVP state for the schedule page:', error);
  }
}

const dressCodeLine = (name: LocalizedString) => `${t(dc.label)}${t(dc.sep)}${t(name)}`;
const paras = (text: LocalizedString) => t(text).split('\n\n').filter(Boolean);
// See .time--digits in the styles below.
const timeClass = (text: LocalizedString) => (/^\d/.test(t(text)) ? 'time time--digits' : 'time');
---

<WireframeLayout title={t(sch.pageTitle)} event="france" page="schedule">
  <header class="site-header">
    <nav class="site-nav">
      <a href="/" class="site-logo">{t(strings.global.siteName)}</a>
      <a href="/france" class="back-link">{t(strings.nav.backToEvent)}</a>
    </nav>
  </header>

  <main>
    <div class="france-page-content" transition:name="france-schedule-content">
      <h1>{t(sch.heading)}</h1>
      <p class="subtitle">{t(sch.subtitle)}</p>

      {rsvpState === 'attending' && calendarToken ? (
        <CalendarCta event="france" token={calendarToken} label={t(sch.calendarBtn)} showNote={false} />
      ) : rsvpState === 'declined' ? (
        <CalendarCta
          event="france"
          token={null}
          label={t(sch.calendarBtn)}
          unavailableNote={t(sch.calendarDeclinedNote)}
        />
      ) : (
        <CalendarCta
          event="france"
          linkHref="/france/rsvp"
          label={t(sch.calendarBtn)}
          note={t(sch.calendarNote)}
          noteHref="/france/rsvp"
        />
      )}

      {features.france.scheduleWeather && (
        <section class="weekend-weather">
          <h2>{t(sch.weather.heading)}</h2>
          <p class="weather-value"><strong>{t(sch.weather.value)}</strong></p>
          <p class="weather-note">{t(sch.weather.note)}</p>
        </section>
      )}

      <section class="days">
      <!-- Friday -->
      <div class="day-section">
        <h2>{t(sch.friday.heading)}</h2>
        <div class="timeline">
          <div class="timeline-item">
            <span class={timeClass(sch.friday.checkin.time)}>{t(sch.friday.checkin.time)}</span>
            <div class="event">
              <h4>{t(sch.friday.checkin.title)}</h4>
              <p>{t(sch.friday.checkin.desc)}</p>
            </div>
          </div>
          <div class="timeline-item">
            <span class={timeClass(sch.friday.dinner.time)}>{t(sch.friday.dinner.time)}</span>
            <div class="event">
              <h4>{t(sch.friday.dinner.title)}</h4>
              <p class="location">{t(sch.friday.dinner.location)}</p>
              <p>{t(sch.friday.dinner.desc)}</p>
              <div class="event-dresscode">
                <a class="dresscode-link" href="/france/lookbook#friday">{dressCodeLine(dc.friday)}</a>
                {paras(sch.friday.dressCode.desc).map((para) => <p class="dresscode-desc">{para}</p>)}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Saturday -->
      <div class="day-section highlight">
        <h2>{t(sch.saturday.heading)}</h2>
        <div class="timeline">
          <div class="timeline-item">
            <span class="time time--digits time--range">
              <span>{t(sch.saturday.breakfast.time)}</span>
              <span class="time-dash">—</span>
              <span>{t(sch.saturday.breakfast.timeEnd)}</span>
            </span>
            <div class="event">
              <h4>{t(sch.saturday.breakfast.title)}</h4>
              <p>{t(sch.saturday.breakfast.desc)}</p>
            </div>
          </div>
          <div class="timeline-item optional">
            <span class={timeClass(sch.saturday.excursion.time)}>{t(sch.saturday.excursion.time)}</span>
            <div class="event">
              <h4>{t(sch.saturday.excursion.title)}</h4>
              <p>{t(sch.saturday.excursion.desc)}</p>
            </div>
          </div>
          <!-- Ceremony → cocktail → reception run continuously, so they share
               one box with a connecting rule instead of three separate cards. -->
          <div class="timeline-group" data-testid="saturday-evening">
            <div class="timeline-step">
              <span class={timeClass(sch.saturday.ceremony.time)}>{t(sch.saturday.ceremony.time)}</span>
              <div class="event">
                <h4>{t(sch.saturday.ceremony.title)}</h4>
                <p class="location">{t(sch.saturday.ceremony.location)}</p>
              </div>
            </div>
            <div class="timeline-step">
              <span class={timeClass(sch.saturday.cocktail.time)}>{t(sch.saturday.cocktail.time)}</span>
              <div class="event">
                <h4>{t(sch.saturday.cocktail.title)}</h4>
                <p class="location">{t(sch.saturday.cocktail.location)}</p>
              </div>
            </div>
            <div class="timeline-step">
              <span class={timeClass(sch.saturday.reception.time)}>{t(sch.saturday.reception.time)}</span>
              <div class="event">
                <h4>{t(sch.saturday.reception.title)}</h4>
                <p>{t(sch.saturday.reception.desc)}</p>
              </div>
            </div>
            <div class="event-dresscode event-dresscode--group">
              <a class="dresscode-link" href="/france/lookbook#saturday">{dressCodeLine(dc.saturday)}</a>
              {paras(sch.saturday.dressCode.desc).map((para) => <p class="dresscode-desc">{para}</p>)}
              <p class="hat-callout">{t(dc.hats)}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Sunday -->
      <div class="day-section">
        <h2>{t(sch.sunday.heading)}</h2>
        <div class="timeline">
          <div class="timeline-item">
            <span class="time time--digits time--range">
              <span>{t(sch.sunday.breakfast.time)}</span>
              <span class="time-dash">—</span>
              <span>{t(sch.sunday.breakfast.timeEnd)}</span>
            </span>
            <div class="event">
              <h4>{t(sch.sunday.breakfast.title)}</h4>
              <p>{t(sch.sunday.breakfast.desc)}</p>
            </div>
          </div>
          <div class="timeline-item">
            <span class="time time--digits time--range">
              <span>{t(sch.sunday.brunch.time)}</span>
              <span class="time-dash">—</span>
              <span>{t(sch.sunday.brunch.timeEnd)}</span>
            </span>
            <div class="event">
              <h4>{t(sch.sunday.brunch.title)}</h4>
              <p class="location">{t(sch.sunday.brunch.location)}</p>
              <p>{t(sch.sunday.brunch.desc)}</p>
              <div class="event-dresscode">
                <span class="dresscode-name">{dressCodeLine(dc.sunday)}</span>
              </div>
            </div>
          </div>
          <div class="timeline-item">
            <span class={timeClass(sch.sunday.venueCloses.time)}>{t(sch.sunday.venueCloses.time)}</span>
            <div class="event">
              <h4>{t(sch.sunday.venueCloses.title)}</h4>
            </div>
          </div>
        </div>
      </div>
      </section>
    </div>

  </main>

  <SiteFooter guest={guest} lang={Astro.locals.lang ?? 'en'} homeHref="/france" />
</WireframeLayout>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
  }

main {
    flex: 1;
    padding: 3rem 2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  /* Stay Info */
  .stay-info {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--color-bg);
    margin-bottom: 1.5rem;
  }

  .stay-time {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stay-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .stay-value {
    font-weight: 500;
    color: var(--color-text);
  }

  .stay-divider {
    width: 1px;
    height: 2.5rem;
    background: var(--color-border);
  }

  /* Weather */
  .weekend-weather {
    margin-bottom: 2.5rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .weekend-weather h2 {
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .weather-value {
    margin: 0 0 0.25rem;
  }

  .weather-note {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Days */
  .days {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .day-section h2 {
    font-size: 1.625rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .day-section.highlight h2 {
    border-bottom-color: var(--color-text);
  }

  .day-note {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .timeline-item.optional {
    border-style: dashed;
    background: var(--color-bg);
  }

  /* The time and the event title share one line-box height, so their first
   * lines sit on the same row. See .event h4. */
  .time {
    font-size: 1rem;
    line-height: 1.6rem;
    font-weight: 600;
    color: var(--color-text);
    min-width: 80px;
    flex-shrink: 0;
  }

  /* Futura's figures are shorter than its capitals, so a time that starts
   * with a digit ("5:00 PM", "17 h 30") tops out ~1.5px below the title's
   * capitals even on an equal line box. Lift those; a time that starts with
   * a letter ("Evening", "Matin") already lines up. Measured against the
   * rendered glyphs in Chromium; rem-based, so it scales with the root. */
  .time--digits {
    position: relative;
    top: -0.083rem;
  }

  .event {
    flex: 1;
  }

  .event h4 {
    margin: 0 0 0.25rem 0;
    font-size: 1.125rem;
    line-height: 1.6rem; /* matches .time */
    font-weight: 500;
  }

  .event p {
    margin: 0;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .event .location {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: 0.25rem;
  }

  .placeholder-note {
    font-style: italic;
    color: var(--color-text-muted) !important;
  }

  /* Stacked time range: start / dash / end on their own lines. */
  .time--range {
    display: flex;
    flex-direction: column;
  }

  .time-dash {
    color: var(--color-text-muted);
  }

  /* Ceremony, cocktail hour and reception: one continuous box. Each step's
   * time sits on a vertical rule with a disc, so the eye reads one evening
   * rather than three separate appointments. */
  .timeline-group {
    border: 2px solid var(--color-text);
    background: var(--color-bg);
    padding: 1rem;
  }

  .timeline-step {
    position: relative;
    display: flex;
    gap: 1.5rem;
    padding: 0 0 1.25rem 1.5rem;
  }

  .timeline-step::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.45rem;
    bottom: -0.45rem;
    width: 2px;
    background: var(--color-accent);
  }

  /* Last step: no rule running on past its disc. (:last-of-type would match
   * the dress-code div that follows, so test for a following step.) */
  .timeline-step:not(:has(+ .timeline-step))::before {
    bottom: auto;
    height: 0;
  }

  .timeline-step::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Dress code, inside the box of the event it applies to. */
  .event-dresscode {
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border);
  }

  .event-dresscode--group {
    margin-top: 0.25rem;
  }

  .dresscode-link,
  .dresscode-name {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.1rem; /* 19.8px on the 18px desktop root */
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-h3);
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .dresscode-link {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .dresscode-link::after {
    content: '\00a0→'; /* non-breaking: the arrow never wraps alone */
    font-family: var(--font-arrow);
  }

  .dresscode-link:hover {
    color: var(--color-accent-text);
  }

  .dresscode-desc,
  .event .dresscode-desc {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .event-dresscode .hat-callout {
    margin-top: 0.75rem;
  }

  @media (max-width: 480px) {
    .stay-info {
      flex-direction: column;
      gap: 1rem;
    }

    .stay-divider {
      width: 100%;
      height: 1px;
    }

    .timeline-item {
      flex-direction: column;
      gap: 0.5rem;
    }

    .time {
      min-width: auto;
    }

    .time--digits {
      top: 0; /* stacked above the title here, nothing to line up with */
    }

    .timeline-step {
      flex-direction: column;
      gap: 0.25rem;
    }

    .dresscode-link,
    .dresscode-name {
      font-size: 0.9rem; /* 15.3px on the 17px mobile root */
    }

    /* Single-column layout: the range reads fine on one line again. */
    .time--range {
      flex-direction: row;
      gap: 0.4em;
    }
  }
</style>
