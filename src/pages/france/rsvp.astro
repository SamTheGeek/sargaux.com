---
import WireframeLayout from '../../layouts/WireframeLayout.astro';
import { getGuestParty, getGuestEvents, getLatestRSVPForParty } from '../../lib/notion';
import { features } from '../../config/features';
import { strings } from '../../content/strings';
import { createTranslator } from '../../lib/i18n';
import { localizeEvent } from '../../lib/event-i18n';
import SiteFooter from '../../components/SiteFooter.astro';
import LoadingDots from '../../components/LoadingDots.astro';
import { memberAttendedResponse } from '../../lib/rsvp-attendance';
import type { GuestRecord, EventRecord, RSVPResponse } from '../../types';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const guest = Astro.locals.guest ?? 'Guest';
const guestId = Astro.locals.guestId;
const PREVIEW_SUBMITTED_AT = '2025-12-13T20:21:00-05:00';

let party: GuestRecord[] = [];
let coreEvents: EventRecord[] = [];
let optionalEvents: EventRecord[] = [];
let existingRSVP: RSVPResponse | null = null;
let loadError: string | null = null;

const isPreview = features.nyc.rsvpPreview && !guestId;

if (isPreview) {
  party = [
    {
      id: 'preview-sam',
      name: 'Sam Gross',
      normalizedName: 'sam gross',
      eventInvitations: ['nyc', 'france'],
      isPlusOne: false,
      relatedGuestIds: ['preview-margaux'],
      email: 'sam@samthegeek.net',
    },
    {
      id: 'preview-margaux',
      name: 'Margaux Ancel',
      normalizedName: 'margaux ancel',
      eventInvitations: ['nyc', 'france'],
      isPlusOne: false,
      relatedGuestIds: ['preview-sam'],
      email: undefined,
    },
  ];
  // Mirrors the live Event Catalog rows (incl. the "* FR" French variants)
  // so preview mode exercises the same ordering and localization paths.
  coreEvents = [
    {
      id: 'preview-event-friday-dinner',
      name: 'Friday Welcome Dinner',
      type: 'Core',
      wedding: 'france',
      time: '7:00 PM',
      date: '2027-05-28',
      location: 'Village Square',
      nameFr: 'Dîner au Marché du Village',
      timeFr: 'Vers 19 h',
      locationFr: 'La Place du Village',
      showOnWebsite: true,
    },
    {
      id: 'preview-event-ceremony',
      name: 'Saturday Ceremony & Reception',
      type: 'Core',
      wedding: 'france',
      time: '2:00 PM',
      date: '2027-05-29',
      location: 'La Mairie',
      nameFr: 'Cérémonie, cocktail, dîner & soirée dansante',
      timeFr: 'À partir de 17 h',
      locationFr: 'La Mairie',
      showOnWebsite: true,
    },
    {
      id: 'preview-event-brunch',
      name: 'Sunday Farewell Brunch',
      type: 'Core',
      wedding: 'france',
      time: '10:00 AM',
      date: '2027-05-30',
      location: 'Village Square',
      nameFr: 'Brunch & jeux',
      timeFr: '11 h 30–14 h',
      locationFr: 'La Place du Village',
      showOnWebsite: true,
    },
  ];
  optionalEvents = [
    {
      id: 'preview-event-excursion',
      name: 'Giverny Excursion',
      type: 'Optional',
      wedding: 'france',
      time: '10:00 AM',
      date: '2027-05-29',
      location: 'Departs from Village to Giverny',
      nameFr: 'Option excursion à Giverny',
      timeFr: '10 h',
      locationFr: 'Départ du Village',
      showOnWebsite: true,
    },
  ];
  existingRSVP = {
    id: 'preview-france-rsvp',
    guestId: 'preview-sam',
    guestIds: ['preview-sam', 'preview-margaux'],
    event: 'france',
    submittedAt: PREVIEW_SUBMITTED_AT,
    status: 'Attending',
    guestsAttending: 'Sam Gross, Margaux Ancel',
    dietary: '',
    message: '',
    details: {
      accommodation: 'yes',
    },
    eventsAttending: ['preview-event-friday-dinner', 'preview-event-ceremony', 'preview-event-brunch'],
  };
} else if (guestId) {
  try {
    const [partyResult, allEvents] = await Promise.all([
      getGuestParty(guestId),
      getGuestEvents(guestId),
    ]);
    party = partyResult;
    const events = allEvents.filter((event) => event.wedding === 'france');
    coreEvents = events.filter((event) => event.type === 'Core');
    optionalEvents = events.filter((event) => event.type === 'Optional');
    // Party-level lookup: a response submitted by any party member pre-fills
    // the form for every member, so returning guests never see a blank form.
    existingRSVP = await getLatestRSVPForParty(
      party.map((member) => member.id),
      'france'
    );
  } catch (error) {
    console.error('Failed to load France RSVP data:', error);
    loadError = 'We could not load your RSVP details right now. Please refresh and try again.';
  }
}

const selectedEventIds = new Set(existingRSVP?.eventsAttending ?? []);
const existingDetails = existingRSVP?.details ?? {};
const lang = Astro.locals.lang ?? 'en';
const t = createTranslator(lang);
const confirmationEmailRequired = t(strings.france.rsvp.form.email.requireOne);
const confirmationEmailAllRequired = t(strings.france.rsvp.form.email.requireAll);
const requireAllEmails = features.global.rsvpRequireAllEmails;
const attendingLabel = t(strings.global.attending);
const notAttendingLabel = t(strings.global.notAttending);
const eventYesLabel = t(strings.global.eventAttendingOption);
const eventNoLabel = t(strings.global.eventNotAttendingOption);
const declineLabel = t(strings.global.regretfullyDecline);
const eventSelectionRequired = t(strings.global.eventSelectionRequired);
const accommodationSelectionRequired = t(strings.france.rsvp.form.accommodation.required);
const emailRequiredShort = t(strings.global.emailRequiredShort);
const emailInvalid = t(strings.global.emailInvalid);
const sessionExpired = t(strings.global.sessionExpired);
// A stored response records a yes/no per event; without one every dropdown
// starts blank and the guest must choose for each event.
const hasEventSelections = existingRSVP?.eventsAttending !== undefined;

const submittedAtISO = existingRSVP?.submittedAt ?? null;
const submittedAtFallback = submittedAtISO
  ? new Date(submittedAtISO).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : null;
---

<WireframeLayout title={t(strings.france.rsvp.pageTitle)} event="france">
  <header class="site-header">
    <nav class="site-nav">
      <a href="/" class="site-logo">{t(strings.global.siteName)}</a>
      <a href="/france" class="back-link">{t(strings.nav.backToEvent)}</a>
    </nav>
  </header>

  <main>
    <div class="france-page-content" transition:name="france-rsvp-content">
      <h1>{t(strings.france.rsvp.heading)}</h1>
      <p class="subtitle">{t(strings.france.rsvp.subtitle)}</p>

      <div class="deadline-banner">
        <p>{existingRSVP ? t(strings.france.rsvp.existingBanner.prefix) : t(strings.france.rsvp.deadline)} <strong>{t(strings.france.rsvp.deadlineDate)}</strong></p>
      </div>

      {!guestId && !isPreview ? (
        <div class="error-card" data-testid="notion-required">
          <h2>{t(strings.france.rsvp.unavailable.heading)}</h2>
          <p>{t(strings.france.rsvp.unavailable.text)}</p>
        </div>
      ) : loadError ? (
        <div class="error-card" data-testid="rsvp-load-error">
          <h2>{t(strings.france.rsvp.loadError.heading)}</h2>
          <p>{loadError}</p>
        </div>
      ) : (
        <>
          <form
            class="rsvp-form"
            id="rsvp-form"
            novalidate
            data-event="france"
            data-confirm-email-required={confirmationEmailRequired}
            data-confirm-email-all-required={confirmationEmailAllRequired}
            data-require-all-emails={requireAllEmails}
            data-attending-label={attendingLabel}
            data-not-attending-label={notAttendingLabel}
            data-decline-label={declineLabel}
            data-email-required-short={emailRequiredShort}
            data-email-invalid={emailInvalid}
            data-session-expired={sessionExpired}
            data-is-local-dev={import.meta.env.DEV}
          >
          <section class="form-section">
            <h2>{t(strings.france.rsvp.form.whosComing.heading)}</h2>
            <p class="section-note">{t(strings.france.rsvp.form.whosComing.note)}</p>

            {party.map((partyGuest) => {
              // With a stored response, the toggle mirrors it exactly — a
              // declined RSVP (empty attendee list) re-opens with everyone
              // off, not the first-visit default of checked non-plus-ones.
              // Resolved by recorded per-member attendance, then Status, then
              // names — never names alone: a renamed member (maiden surname,
              // Also Known As form, a named +1) no longer matches the stored
              // attendee list, and pre-filling them as "not attending" lets
              // an unrelated update silently persist a decline for them.
              const isAttending = existingRSVP
                ? memberAttendedResponse(existingRSVP, partyGuest)
                : !partyGuest.isPlusOne;

              return (
                <div class:list={["guest-row", partyGuest.isPlusOne && 'plus-one']} data-guest-row data-guest-id={partyGuest.id}>
                  <label class="guest-toggle">
                    <input
                      type="checkbox"
                      class="guest-attending"
                      checked={isAttending}
                    />
                    <span class="toggle-slider"></span>
                  </label>
                  <div class="guest-info">
                    <input
                      type="text"
                      class="guest-name"
                      value={partyGuest.name}
                      data-plus-one={partyGuest.isPlusOne ? 'true' : 'false'}
                    />
                    <span class="guest-status">{isAttending ? t(strings.global.attending) : t(strings.global.notAttending)}</span>
                  </div>
                </div>
              );
            })}
          </section>

          <section class="form-section">
            <h2>{t(strings.france.rsvp.form.coreEvents.heading)}</h2>
            <p class="section-note">{t(strings.france.rsvp.form.coreEvents.note)}</p>
            {coreEvents.length === 0 ? (
              <p class="placeholder-note">{t(strings.france.rsvp.form.coreEvents.empty)}</p>
            ) : (
              <div class="event-list">
                {coreEvents.map((event) => {
                  const loc = localizeEvent(event, lang);
                  return (
                  <div class="event-row is-core">
                    <div class="event-details">
                      <strong>{loc.name}</strong>
                      <span class="event-info">{[loc.time, loc.location].filter(Boolean).join(' · ') || t(strings.global.detailsToCome)}</span>
                      <p class="event-row-error" hidden>{eventSelectionRequired}</p>
                    </div>
                    <select
                      class="event-attending event-select"
                      data-event-id={event.id}
                      data-event-type="core"
                      required
                      aria-label={loc.name}
                    >
                      <option value="" disabled selected={!hasEventSelections}>—</option>
                      <option value="yes" selected={hasEventSelections && selectedEventIds.has(event.id)}>{eventYesLabel}</option>
                      <option value="no" selected={hasEventSelections && !selectedEventIds.has(event.id)}>{eventNoLabel}</option>
                    </select>
                  </div>
                  );
                })}
              </div>
            )}
          </section>

          <section class="form-section">
            <h2>{t(strings.france.rsvp.form.optionalEvents.heading)}</h2>
            <p class="section-note">{t(strings.france.rsvp.form.optionalEvents.note)}</p>

            {optionalEvents.length === 0 ? (
              <p class="placeholder-note" data-testid="no-optional-events">{t(strings.france.rsvp.form.optionalEvents.empty)}</p>
            ) : (
              <div class="event-list">
                {optionalEvents.map((event) => {
                  const loc = localizeEvent(event, lang);
                  return (
                  <div class="event-row optional-event">
                    <div class="event-details">
                      <strong>{loc.name}</strong>
                      <span class="event-info">{[loc.time, loc.location].filter(Boolean).join(' · ') || t(strings.global.detailsToCome)}</span>
                      <p class="event-row-error" hidden>{eventSelectionRequired}</p>
                    </div>
                    <select
                      class="event-attending event-select"
                      data-event-id={event.id}
                      data-event-type="optional"
                      required
                      aria-label={loc.name}
                    >
                      <option value="" disabled selected={!hasEventSelections}>—</option>
                      <option value="yes" selected={hasEventSelections && selectedEventIds.has(event.id)}>{eventYesLabel}</option>
                      <option value="no" selected={hasEventSelections && !selectedEventIds.has(event.id)}>{eventNoLabel}</option>
                    </select>
                  </div>
                  );
                })}
              </div>
            )}
          </section>

          <section class="form-section">
            <h2>{t(strings.france.rsvp.form.dietary.heading)}</h2>
            <p class="section-note">{t(strings.france.rsvp.form.dietary.note)}</p>
            <p class="section-note">{t(strings.france.rsvp.form.dietary.childrenNote)}</p>
            <textarea
              name="allergens"
              class="text-input"
              placeholder={t(strings.france.rsvp.form.dietary.placeholder)}
              rows="3"
              maxlength="2000"
            >{existingDetails.allergens ?? existingRSVP?.dietary ?? ''}</textarea>
          </section>

          <section class="form-section">
            <div>
              <h2>{t(strings.france.rsvp.form.accommodation.heading)}</h2>
              <div class="recommendation-banner">
                <p>{t(strings.france.rsvp.form.accommodation.intro)}</p>
              </div>
              <p class="section-note">{t(strings.france.rsvp.form.accommodation.question)}</p>
              <select name="accommodation" class="single-line-input" required>
                <option value="" disabled selected={existingDetails.accommodation === undefined}>—</option>
                <option value="unsure" selected={existingDetails.accommodation === 'unsure'}>{t(strings.france.rsvp.form.accommodation.unsure)}</option>
                <option value="yes" selected={existingDetails.accommodation === 'yes'}>{t(strings.france.rsvp.form.accommodation.yes)}</option>
                <option value="no" selected={existingDetails.accommodation === 'no'}>{t(strings.france.rsvp.form.accommodation.no)}</option>
              </select>
              <p class="accommodation-error" hidden>{accommodationSelectionRequired}</p>
              <p class="section-note accommodation-followup">{t(strings.france.rsvp.form.accommodation.followup)}</p>
            </div>
          </section>

          <section class="form-section">
            <h2>{t(strings.france.rsvp.form.message.heading)}</h2>
            <p class="section-note">{t(strings.france.rsvp.form.message.note)}</p>
            <textarea
              name="message"
              class="text-input"
              maxlength="2000"
              placeholder={t(strings.france.rsvp.form.message.placeholder)}
              rows="4"
            >{existingRSVP?.message ?? ''}</textarea>
          </section>

          <section class="form-section">
            <h2>{t(strings.france.rsvp.form.email.heading)}</h2>
            <label class="checkbox-label">
              <input type="checkbox" id="send-confirmation" name="sendConfirmation" data-testid="send-confirmation-checkbox" />
              <span>{t(strings.france.rsvp.form.email.sendConfirmation)}</span>
            </label>
            <p class="section-note confirmation-note">{t(strings.france.rsvp.form.email.note)}</p>
            <div class="group-email-list">
              {party.map((partyGuest) => (
                <div class="email-field group-email-row">
                  <label for={`guest-email-${partyGuest.id}`} class="section-note group-email-label">
                    <span class="group-email-name">{partyGuest.name}</span>
                  </label>
                  <input
                    type="email"
                    id={`guest-email-${partyGuest.id}`}
                    class="single-line-input group-email-input"
                    placeholder={t(strings.france.rsvp.form.email.placeholder)}
                    autocomplete="email"
                    value={partyGuest.email ?? ''}
                    data-testid="group-email-input"
                    data-guest-email-id={partyGuest.id}
                    data-guest-email-name={partyGuest.name}
                  />
                  <p class="group-email-error" hidden></p>
                </div>
              ))}
            </div>
          </section>

          {existingRSVP && submittedAtFallback && (
            <p class="last-submitted-note">
              {t(strings.france.rsvp.form.lastSubmittedLabel)} <strong><time datetime={submittedAtISO!} data-local-timestamp>{submittedAtFallback}</time></strong>
            </p>
          )}
          <button type="submit" class="submit-btn"><span class="btn-label">{existingRSVP ? t(strings.france.rsvp.form.updateBtn) : t(strings.france.rsvp.form.submitBtn)}</span><span class="btn-progress">{t(strings.global.savingBtn)}<LoadingDots /></span></button>

          <div class="feedback" aria-live="polite">
            <p id="form-success" class="success-message" hidden>{t(strings.france.rsvp.form.successMsg)}</p>
            <p id="form-error" class="error-message" hidden>{t(strings.france.rsvp.form.errorMsg)}</p>
          </div>

          <p class="form-note">{t(strings.france.rsvp.form.signedInAs)} <strong>{guest}</strong>. {t(strings.france.rsvp.form.canUpdate)}</p>
          </form>
        </>
      )}
    </div>
  </main>

  <SiteFooter guest={guest} lang={Astro.locals.lang ?? 'en'} homeHref="/france" />
</WireframeLayout>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
  }

main {
    flex: 1;
    padding: 3rem 2rem;
    max-width: 680px;
    margin: 0 auto;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .deadline-banner {
    background: var(--color-bg);
    border: 1px solid var(--color-border);

    padding: 1rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .rsvp-form {
    display: flex;
    flex-direction: column;
  }

  .form-section {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .form-section:last-of-type {
    border-bottom: none;
  }

  .form-section h2 {
    font-size: 1.325rem;
    margin-bottom: 0.5rem;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .section-note {
    font-size: 1.025rem;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .recommendation-banner {
    background: var(--color-info-bg);
    border: 1px solid var(--color-accent);
    padding: 1.25rem;
    margin: 0 0 1rem;
  }

  .recommendation-banner strong {
    display: block;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .recommendation-banner p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .guest-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem;
    border: 1px solid var(--color-border);

    margin-bottom: 0.75rem;
  }

  .guest-row.plus-one {
    border-style: dashed;
  }

  .guest-toggle {
    position: relative;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
  }

  .guest-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    inset: 0;
    background: var(--color-border);
    border-radius: 999px;
    transition: background 0.2s;
  }

  .toggle-slider::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    left: 3px;
    top: 3px;
    border-radius: 50%;
    background: var(--color-bg);
    transition: transform 0.2s;
  }

  .guest-toggle input:checked + .toggle-slider {
    background: var(--color-text);
  }

  .guest-toggle input:checked + .toggle-slider::before {
    transform: translateX(20px);
  }

  .guest-info {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.75rem;
  }

  .guest-name {
    flex: 1;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    padding: 0.5rem 0.6rem;
    font-size: 1.075rem;
  }

  .guest-status {
    font-size: 0.925rem;
    color: var(--color-text-muted);
    min-width: 90px;
    text-align: right;
  }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem;
    border: 1px solid var(--color-border);
  }

  .event-row.is-core {
    background: var(--color-bg);
  }

  .event-details {
    flex: 1;
    min-width: 0;
  }

  .event-select {
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.6rem;
    font-size: 1rem;
    font-family: inherit;
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }

  .event-select.has-error {
    border-color: var(--color-burnt-amber);
  }

  .event-row-error {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--color-burnt-amber);
  }

  select[name='accommodation'].has-error {
    border-color: var(--color-burnt-amber);
  }

  .accommodation-error {
    margin: 0.3rem 0 0.9rem;
    font-size: 0.9rem;
    color: var(--color-burnt-amber);
  }

  .event-details strong {
    display: block;
    margin-bottom: 0.1rem;
  }

  .event-info {
    color: var(--color-text-muted);
    font-size: 0.985rem;
  }

  .placeholder-note {
    color: var(--color-text-muted);
    font-size: 1.025rem;
  }

  .single-line-input,
  .text-input {
    width: 100%;
    border: 1px solid var(--color-border);

    padding: 0.7rem 0.75rem;
    font-size: 1.075rem;
    font-family: inherit;
  }

  .feedback {
    margin-top: 0.4rem;
    min-height: 1.5rem;
    text-align: center;
  }

  .success-message {
    color: var(--color-success);
    font-size: 1.025rem;
  }

  .error-message {
    color: var(--color-error);
    font-size: 1.025rem;
  }

  .submit-btn {
    display: block;
    width: 100%;
    max-width: 540px;
    margin-top: 0.2rem;
    margin-left: auto;
    margin-right: auto;
    height: 56px;
    border: none;

    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: var(--font-size-caption);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-heading);
    font-feature-settings: "case" 1;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .last-submitted-note {
    margin: 0 0 var(--space-xs);
    color: var(--color-text-muted);
    font-size: 15px;
    text-align: center;
  }

  .form-note {
    margin-top: 0.3rem;
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: 0.975rem;
    text-align: center;
  }

  .email-field {
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .confirmation-note {
    margin-top: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .group-email-list {
    display: grid;
    gap: 22px;
