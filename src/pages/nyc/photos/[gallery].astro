---
import { nycRsvpButtonHref } from '../../../lib/nyc-rsvp-lock';
import WireframeLayout from '../../../layouts/WireframeLayout.astro';
import '../../../styles/nyc-subpages.css';
import '../../../styles/nyc-photos.css';
import { strings } from '../../../content/strings';
import { createTranslator } from '../../../lib/i18n';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhotoGallery from '../../../components/PhotoGallery.astro';
import PhotoLightbox from '../../../components/PhotoLightbox.astro';
import { features } from '../../../config/features';
import { getNycGallery } from '../../../content/nycGalleries';

// Unknown or still-empty galleries (and everything while the flag is off) 404,
// so a gallery's URL only exists once it has photos.
const gallery = features.nyc.photoGallery ? getNycGallery(Astro.params.gallery) : null;
if (!gallery) {
  return Astro.rewrite('/404');
}

const guest = Astro.locals.guest;
const eventInvitations = Astro.locals.eventInvitations ?? ['nyc', 'france'];
const showEventToggle = eventInvitations.includes('nyc') && eventInvitations.includes('france');
const lang = Astro.locals.lang ?? 'en';
const t = createTranslator(lang);
const title = t(strings.nyc.photos.galleries[gallery.id]);
// Post-event, the header RSVP button links to the saved confirmation, and only
// for parties that have one (see src/lib/nyc-rsvp-lock.ts).
const rsvpHref = await nycRsvpButtonHref(Astro.locals.guestId);
---

<WireframeLayout title={title} fullTitle={`Chez Sargaux | NYC — ${title}`} event="nyc" page="photos">

  <!-- Amber disc — z:2. Sits behind .nyc-page-main (z:5) during transitions. -->
  <div class="nyc-disc" aria-hidden="true" transition:name="event-disc"></div>

  <header class="site-header nyc-header" transition:name="site-header">
    <nav class="site-nav">
      <a href="/" class="site-logo">{t(strings.global.siteName)}</a>
      <div class="nav-actions">
        {showEventToggle && (
          <div class="event-toggle">
            <span class="active event-toggle-item event-toggle-item--nyc">{t(strings.global.toggle.nyc)}</span>
            <span class="divider">|</span>
            <a href="/france" class="event-toggle-item event-toggle-item--france">{t(strings.global.toggle.france)}</a>
          </div>
        )}
        {rsvpHref && (
          <a href={rsvpHref} class="btn nyc-rsvp-btn">{t(strings.global.rsvpBtn)}</a>
        )}
      </div>
    </nav>
  </header>

  <div class="nyc-page-main">
    <div class="details-hero photos-hero">
      <div class="page-content photos-hero-inner">
        <a href="/nyc" class="details-back">{t(strings.nav.backToEvent)}</a>
        <h1>{title}</h1>
        <p class="details-date">{t(strings.nyc.photos.band)}</p>
      </div>
    </div>
  </div>

  <div class="nyc-page-moss">
    <section class="nyc-moss details-section nyc-photos-full">
      <div class="page-content">
        <PhotoGallery gallery={gallery.id} photos={gallery.photos} variant="full" lang={lang} />
      </div>
    </section>

    <SiteFooter className="nyc-moss nyc-footer" guest={guest} lang={lang} homeHref="/nyc" />
  </div>

  <PhotoLightbox lang={lang} />

</WireframeLayout>

<style is:global>
  html[data-event="nyc"][data-page="photos"] body {
    background: var(--color-warm-cream) !important;
    color: var(--color-dark-moss) !important;
    overflow-x: hidden;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-header {
    background: var(--color-warm-cream) !important;
    border-bottom: 1px solid rgba(23, 50, 11, 0.18) !important;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-header .site-logo,
  html[data-event="nyc"][data-page="photos"] .nyc-header .site-logo:hover,
  html[data-event="nyc"][data-page="photos"] .nyc-header .event-toggle .active,
  html[data-event="nyc"][data-page="photos"] .nyc-header .event-toggle .divider {
    color: var(--color-dark-moss) !important;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-header .event-toggle a {
    color: rgba(23, 50, 11, 0.4) !important;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-rsvp-btn {
    background: var(--color-dark-moss) !important;
    color: var(--color-warm-cream) !important;
    height: 32px;
    padding: 0 24px;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    line-height: 1;
    transition: opacity 0.15s;
    border: none;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-rsvp-btn:hover {
    opacity: 0.85;
    color: var(--color-warm-cream) !important;
  }

  /* Disc on the right, mirroring the travel page, so it clears the left-aligned title. */
  html[data-event="nyc"][data-page="photos"] .nyc-disc {
    position: fixed;
    width: clamp(300px, 50vh, 580px);
    height: clamp(300px, 50vh, 580px);
    background: var(--color-burnt-amber);
    border-radius: 50%;
    top: 3vh;
    right: -8%;
    z-index: 2;
  }

  html[data-event="nyc"][data-page="photos"] .details-hero {
    position: relative;
    z-index: 3;
    min-height: 38vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 48px;
  }

  html[data-event="nyc"][data-page="photos"] .photos-hero-inner {
    width: 100%;
  }

  html[data-event="nyc"][data-page="photos"] .details-back,
  html[data-event="nyc"][data-page="photos"] .details-back:link,
  html[data-event="nyc"][data-page="photos"] .details-back:visited {
    display: inline-block;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-dark-moss);
    -webkit-text-fill-color: var(--color-dark-moss);
    text-decoration: none;
    margin-bottom: 24px;
    transition: opacity 0.15s;
  }

  html[data-event="nyc"][data-page="photos"] .details-back:hover {
    opacity: 0.6;
  }

  html[data-event="nyc"][data-page="photos"] .details-hero h1 {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 500;
    line-height: 0.93;
    color: var(--color-dark-moss);
    text-transform: uppercase;
    margin: 0 0 20px;
    white-space: nowrap;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-moss {
    position: relative;
    z-index: 4;
  }

  html[data-event="nyc"][data-page="photos"] .details-section,
  html[data-event="nyc"][data-page="photos"] .nyc-footer {
    background: var(--color-dark-moss) !important;
    color: var(--color-warm-cream) !important;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-footer {
    border-top-color: rgba(255, 249, 240, 0.12) !important;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-footer nav a,
  html[data-event="nyc"][data-page="photos"] .nyc-footer nav span,
  html[data-event="nyc"][data-page="photos"] .nyc-footer .copyright {
    color: rgba(255, 249, 240, 0.4) !important;
  }

  html[data-event="nyc"][data-page="photos"] .nyc-footer nav a:hover {
    color: var(--color-warm-cream) !important;
  }

  @media (prefers-color-scheme: dark) {
    html[data-event="nyc"][data-page="photos"] body {
      background: var(--color-dark-moss) !important;
      color: var(--color-warm-cream) !important;
    }

    html[data-event="nyc"][data-page="photos"] .nyc-header {
      background: var(--color-dark-moss) !important;
      border-bottom-color: rgba(255, 249, 240, 0.08) !important;
    }

    html[data-event="nyc"][data-page="photos"] .nyc-header .site-logo,
    html[data-event="nyc"][data-page="photos"] .nyc-header .site-logo:hover,
    html[data-event="nyc"][data-page="photos"] .nyc-header .event-toggle .active,
    html[data-event="nyc"][data-page="photos"] .nyc-header .event-toggle .divider {
      color: var(--color-warm-cream) !important;
    }

    html[data-event="nyc"][data-page="photos"] .nyc-header .event-toggle a {
      color: rgba(255, 249, 240, 0.45) !important;
    }

    html[data-event="nyc"][data-page="photos"] .nyc-rsvp-btn {
      background: var(--color-burnt-amber) !important;
    }

    html[data-event="nyc"][data-page="photos"] .details-hero h1 {
      color: var(--color-warm-cream) !important;
    }

    html[data-event="nyc"][data-page="photos"] .details-back,
    html[data-event="nyc"][data-page="photos"] .details-back:link,
    html[data-event="nyc"][data-page="photos"] .details-back:visited {
      color: rgba(255, 249, 240, 0.7) !important;
      -webkit-text-fill-color: rgba(255, 249, 240, 0.7) !important;
    }

    html[data-event="nyc"][data-page="photos"] .details-section,
    html[data-event="nyc"][data-page="photos"] .nyc-footer {
      background: var(--color-nyc-skyline-dark) !important;
    }
  }

  @media (max-width: 768px) {
    html[data-event="nyc"][data-page="photos"] .details-hero {
      min-height: 28vh;
      padding-bottom: 32px;
    }

    html[data-event="nyc"][data-page="photos"] .details-hero h1 {
      font-size: clamp(40px, 12vw, 64px);
      white-space: normal;
    }
  }
</style>
