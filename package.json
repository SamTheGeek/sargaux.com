{
  "name": "sargaux.com",
  "type": "module",
  "version": "2.0.4",
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "astro dev",
    "icons": "node scripts/generate-icons.ts",
    "prebuild": "node scripts/check-node-version.mjs && node scripts/generate-icons.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pretypecheck": "node scripts/check-node-version.mjs",
    "typecheck": "astro check",
    "pretest": "node scripts/check-node-version.mjs && bash scripts/ensure-browsers.sh",
    "test": "playwright test",
    "pretest:unit": "node scripts/check-node-version.mjs",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:ui": "playwright test --ui",
    "pretest:quick": "node scripts/check-node-version.mjs",
    "test:quick": "playwright test tests/accessibility.spec.ts",
    "test:install": "playwright install --with-deps chromium",
    "test:security": "playwright test tests/security.spec.ts tests/security-headers.spec.ts tests/auth.spec.ts tests/auth-unit.spec.ts tests/rate-limit-unit.spec.ts tests/rsvp-api.spec.ts tests/access-control.spec.ts",
    "secret-scan": "bash scripts/secret-scan.sh",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.10",
    "@astrojs/node": "^11.1.9",
    "@netlify/blobs": "^11.1.6",
    "@notionhq/client": "^5.28.0",
    "astro": "^7.4.2",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@netlify/edge-functions": "^4.0.3",
    "@netlify/functions": "^6.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "exceljs": "^4.4.0",
    "node-gyp": "^13.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@opentelemetry/core": "2.9.0",
    "brace-expansion": "^5.0.12",
    "sharp": "^0.35.5",
    "unstorage": {
      "@netlify/blobs": "$@netlify/blobs"
    }
  }
}
