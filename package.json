{
  "name": "sargaux.com",
  "type": "module",
  "version": "1.3.2",
  "scripts": {
    "dev": "astro dev",
    "icons": "tsx scripts/generate-icons.ts",
    "prebuild": "tsx scripts/generate-icons.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "pretest": "bash scripts/ensure-browsers.sh",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:quick": "playwright test tests/accessibility.spec.ts",
    "test:install": "playwright install --with-deps chromium",
    "test:security": "playwright test tests/security.spec.ts tests/security-headers.spec.ts tests/auth.spec.ts tests/auth-unit.spec.ts tests/rate-limit-unit.spec.ts tests/rsvp-api.spec.ts tests/access-control.spec.ts",
    "secret-scan": "bash scripts/secret-scan.sh",
    "gen:lookbook-webp": "tsx scripts/generate-lookbook-webp.ts",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.3",
    "@astrojs/node": "^11.1.2",
    "@netlify/blobs": "^10.7.13",
    "@notionhq/client": "^5.26.0",
    "astro": "^7.2.2",
    "resend": "^6.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@netlify/edge-functions": "^4.0.0",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.62.0",
    "axe-core": "^4.13.0",
    "exceljs": "^4.4.0",
    "node-gyp": "^13.0.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@opentelemetry/core": "2.9.0",
    "brace-expansion": "^5.0.8",
    "sharp": "^0.35.3"
  }
