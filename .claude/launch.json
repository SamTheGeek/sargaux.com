{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sargaux.com dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 1213,
      "default": true
    },
    {
      "name": "sargaux.com preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 1213
    },
    {
      "name": "sargaux.com built",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.env.local", "./dist/server/entry.mjs"],
      "env": { "HOST": "127.0.0.1", "PORT": "1213" },
      "port": 1213
    }
  ]
}
