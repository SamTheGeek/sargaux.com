{
  "enabledPlugins": {
    "github@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/use-nvmrc-node.sh",
            "timeout": 180,
            "statusMessage": "Loading Node from .nvmrc"
          }
        ]
      }
    ]
  }
}
